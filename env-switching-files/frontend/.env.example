# Normally you do NOT need a .env file here.
# The app picks the backend automatically (see lib/config.js):
#   opened on localhost or a 192.168.x.x address -> local backend (port 5000)
#   opened on your real domain                   -> production backend
#
# Only set these to force a specific backend, e.g. in frontend/.env.local:
# VITE_API_URL=https://web-hexachat.onrender.com/api
# VITE_SOCKET_URL=https://web-hexachat.onrender.com
