# Copy this file to backend/.env and fill in the values.
# The server detects local vs production by itself:
#   production = NODE_ENV=production, or running on Render
#   local      = everything else (npm run dev / npm start on your computer)
# For each *_LOCAL / *_PROD pair, the one matching the mode is used.

PORT=5000

# Frontend address (used for CORS)
CLIENT_URL_LOCAL=http://localhost:5173
CLIENT_URL_PROD=https://hexachat.hexalogicx.com

# This backend's own public address (used for links such as profile pictures)
PUBLIC_URL_LOCAL=http://localhost:5000
PUBLIC_URL_PROD=https://web-hexachat.onrender.com

# Database. Use a SEPARATE database for local testing so you never touch real data.
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/hexachat_dev
MONGODB_URI_PROD=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/DB_NAME

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=HexaChat

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: extra allowed browser origins, comma separated
# ALLOWED_ORIGINS=
